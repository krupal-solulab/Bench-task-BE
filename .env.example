NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

MONGO_URI=mongodb://localhost:27017/project_task_management
MONGO_DB_NAME=project_task_management

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_DASHBOARD=60
REDIS_TTL_TREND=300

JWT_ACCESS_SECRET=replace_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_me_too
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

LOG_LEVEL=debug
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=5

SWAGGER_ENABLED=true

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_me

PLATFORM_ADMIN_EMAIL=platform-admin@example.com
PLATFORM_ADMIN_PASSWORD=replace_me

# S3-compatible object storage for task attachments. Point this at a local MinIO
# container (docker-compose already includes one) for dev - no external account needed.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=task-attachments
S3_REGION=us-east-1
