<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title><%= subject %></title>
  <style>
    @media only screen and (max-width: 620px) {
      .container { width: 100% !important; }
      .px { padding-left: 24px !important; padding-right: 24px !important; }
      .btn a { display: block !important; }
    }
  </style>
</head>
<body style="margin:0; padding:0; background-color:#f1f5f9; -webkit-text-size-adjust:100%;">
  <!-- Inbox preview line -->
  <div style="display:none; max-height:0; overflow:hidden; mso-hide:all; font-size:1px; line-height:1px; color:#f1f5f9;">
    <%= inviterName %> invited you to <%= target %>. Your invitation expires on <%= expires %>.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f1f5f9;">
    <tr>
      <td align="center" style="padding:32px 12px;">
        <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px; max-width:600px;">

          <!-- Brand -->
          <tr>
            <td align="center" style="padding:0 0 20px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td width="36" height="36" align="center" valign="middle" style="width:36px; height:36px; background-color:#4f46e5; border-radius:10px; font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:18px; font-weight:700; color:#ffffff;">
                    <%= appName.charAt(0) %>
                  </td>
                  <td style="padding-left:10px; font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:15px; font-weight:600; color:#0f172a;">
                    <%= appName %>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Card -->
          <tr>
            <td style="background-color:#ffffff; border:1px solid #e2e8f0; border-radius:16px; overflow:hidden;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="height:6px; background-color:#4f46e5; line-height:6px; font-size:6px;">&nbsp;</td>
                </tr>
                <tr>
                  <td class="px" style="padding:36px 40px 8px; font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif;">
                    <p style="margin:0 0 8px; font-size:13px; font-weight:600; letter-spacing:0.06em; text-transform:uppercase; color:#4f46e5;">
                      <%= projectName ? 'Project invitation' : 'Invitation' %>
                    </p>
                    <h1 style="margin:0 0 16px; font-size:24px; line-height:32px; font-weight:700; color:#0f172a;">
                      You're invited to join <%= target %>
                    </h1>
                    <p style="margin:0 0 24px; font-size:15px; line-height:24px; color:#334155;">
                      <strong style="color:#0f172a;"><%= inviterName %></strong><% if (projectName) { %> invited you to collaborate on
                      <strong style="color:#0f172a;"><%= projectName %></strong><% if (organizationName) { %> in <%= organizationName %><% } %><% } else { %> invited you to join
                      <strong style="color:#0f172a;"><%= target %></strong> on <%= appName %><% } %>
                      as a <strong style="color:#0f172a;"><%= role %></strong>.
                    </p>
                  </td>
                </tr>

                <!-- Button -->
                <tr>
                  <td class="px btn" align="left" style="padding:0 40px 28px;">
                    <!--[if mso]>
                    <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" href="<%= inviteUrl %>" style="height:46px; v-text-anchor:middle; width:220px;" arcsize="20%" stroke="f" fillcolor="#4f46e5">
                      <center style="color:#ffffff; font-family:Segoe UI, Arial, sans-serif; font-size:15px; font-weight:600;">Accept invitation</center>
                    </v:roundrect>
                    <![endif]-->
                    <!--[if !mso]><!-->
                    <a href="<%= inviteUrl %>" target="_blank" style="display:inline-block; background-color:#4f46e5; color:#ffffff; font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:15px; font-weight:600; line-height:46px; text-align:center; text-decoration:none; padding:0 32px; border-radius:10px;">
                      Accept invitation
                    </a>
                    <!--<![endif]-->
                  </td>
                </tr>

                <!-- Sign-in details -->
                <tr>
                  <td class="px" style="padding:0 40px 28px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f8fafc; border:1px solid #e2e8f0; border-radius:12px;">
                      <tr>
                        <td style="padding:18px 20px 6px; font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:12px; font-weight:600; letter-spacing:0.05em; text-transform:uppercase; color:#64748b;">
                          Your sign-in details
                        </td>
                      </tr>
                      <tr>
                        <td style="padding:6px 20px; font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:14px; color:#334155;">
                          Email<br>
                          <span style="font-size:15px; font-weight:600; color:#0f172a;"><%= email %></span>
                        </td>
                      </tr>
                      <tr>
                        <td style="padding:6px 20px 18px; font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:14px; color:#334155;">
                          Temporary password<br>
                          <span style="display:inline-block; margin-top:4px; padding:6px 12px; background-color:#ffffff; border:1px dashed #a5b4fc; border-radius:8px; font-family:Consolas, Menlo, Courier New, monospace; font-size:17px; font-weight:700; letter-spacing:0.08em; color:#312e81;"><%= temporaryPassword %></span>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Steps -->
                <tr>
                  <td class="px" style="padding:0 40px 8px; font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif;">
                    <p style="margin:0 0 12px; font-size:15px; font-weight:600; color:#0f172a;">How to join</p>
                    <% ['Click <b>Accept invitation</b> above.', 'Enter the temporary password shown above.', 'Add your name and choose your own password.'].forEach(function (step, i) { %>
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 10px;">
                      <tr>
                        <td width="26" valign="top" style="width:26px;">
                          <div style="width:26px; height:26px; line-height:26px; text-align:center; background-color:#eef2ff; border-radius:13px; font-size:13px; font-weight:700; color:#4f46e5;"><%= i + 1 %></div>
                        </td>
                        <td style="padding-left:12px; font-size:14px; line-height:22px; color:#334155;"><%- step %></td>
                      </tr>
                    </table>
                    <% }) %>
                  </td>
                </tr>

                <!-- Expiry -->
                <tr>
                  <td class="px" style="padding:12px 40px 32px; font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#fffbeb; border:1px solid #fde68a; border-radius:10px;">
                      <tr>
                        <td style="padding:12px 16px; font-size:13px; line-height:20px; color:#92400e;">
                          This invitation expires on <strong><%= expires %></strong>. If it expires, ask <%= inviterName %> to resend it.
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Fallback link -->
                <tr>
                  <td class="px" style="padding:0 40px 32px; border-top:1px solid #f1f5f9; font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif;">
                    <p style="margin:20px 0 6px; font-size:13px; color:#64748b;">Button not working? Copy this link into your browser:</p>
                    <p style="margin:0; font-size:13px; line-height:20px; word-break:break-all;">
                      <a href="<%= inviteUrl %>" target="_blank" style="color:#4f46e5; text-decoration:underline;"><%= inviteUrl %></a>
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="padding:24px 24px 0; font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:12px; line-height:18px; color:#94a3b8;">
              You received this email because <%= inviterName %> invited <%= email %> to <%= appName %>.<br>
              If you weren't expecting it, you can safely ignore this email.<br>
              &copy; <%= year %> <%= appName %>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
